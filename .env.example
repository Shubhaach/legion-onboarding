# mock (default) or sandbox
ADAPTER_MODE=mock

# Signs the session cookies. Any long random string; required in production.
SESSION_SECRET=

# Optional: screen 4 concern mapping. Without it, keyword mapping is used.
ANTHROPIC_API_KEY=

# Optional, only when ADAPTER_MODE=sandbox (sandbox adapters are not implemented in this prototype)
SOHAR_API_KEY=
METRIPORT_API_KEY=
